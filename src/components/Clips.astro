---
// The front page's clips, each in a viewfinder: the brand's two signal colours
// used for what they mean and nothing else — red for "this is a recording",
// amber for numbers you can trust, here the version that recorded it and the
// timecode of the frame on screen.
//
// The timecode is the video's own clock, read each animation frame, so it is
// true of whatever frame is showing; the clips are 60 fps, so the last field
// counts 00–59.
interface Props {
	/** Where the renders are served from, without a trailing slash. */
	base: string;
	/** The versioncam version these docs were built from. */
	version: string;
}
const { base, version } = Astro.props;

const clips = [
	{ id: '01-create-a-shipment', caption: 'Create a shipment' },
	{ id: '02-find-a-shipment', caption: 'Find a shipment' },
	{ id: '03-cancel-a-shipment', caption: 'Cancel a shipment' },
];
---

<div class="vc-clips">
	{
		clips.map(({ id, caption }) => (
			<figure class="vc-tile">
				<div class="vc-viewfinder">
					<video
						src={`${base}/${id}.mp4`}
						poster={`${base}/${id}-poster.png`}
						autoplay
						muted
						loop
						playsinline
						preload="metadata"
						aria-label={caption}
					/>
					<span class="vc-osd vc-rec" aria-hidden="true">
						<i />
						REC
					</span>
					<span class="vc-osd vc-ver" aria-hidden="true">
						v{version}
					</span>
					<span class="vc-osd vc-tc" aria-hidden="true">
						00:00:00:00
					</span>
				</div>
				<figcaption>{caption}</figcaption>
			</figure>
		))
	}
</div>

<script>
	const pad = (n: number) => String(Math.floor(n)).padStart(2, '0');
	const timecode = (t: number) =>
		`${pad(t / 3600)}:${pad((t / 60) % 60)}:${pad(t % 60)}:${pad((t % 1) * 60)}`;

	const tiles = [...document.querySelectorAll<HTMLElement>('.vc-viewfinder')].map((tile) => ({
		video: tile.querySelector('video')!,
		label: tile.querySelector<HTMLElement>('.vc-tc')!,
	}));

	const tick = () => {
		for (const { video, label } of tiles) label.textContent = timecode(video.currentTime);
		requestAnimationFrame(tick);
	};
	if (tiles.length > 0) requestAnimationFrame(tick);
</script>
